{
  "name": "toolset-web-tmp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "clean:redundant": "node scripts/clean-redundant.js",
    "clean:all": "npm run clean:redundant",
    "analyze": "cross-env ANALYZE=true next build",
    "fix": "powershell -ExecutionPolicy Bypass -File ./fix-and-start.ps1",
    "quick": "powershell -ExecutionPolicy Bypass -File ./quick-start.ps1",
    "check": "powershell -ExecutionPolicy Bypass -File ./check-and-fix.ps1",
    "pages:build": "npx @cloudflare/next-on-pages",
    "preview:cloudflare": "npx wrangler pages dev .vercel/output/static",
    "deploy:cloudflare": "npm run build && npm run pages:build"
  },
  "dependencies": {
    "react": "^18",
    "react-dom": "^18",
    "next": "14.2.33"
  },
  "devDependencies": {
    "typescript": "^5",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "eslint": "^8",
    "eslint-config-next": "14.2.33",
    "@cloudflare/next-on-pages": "^1.13.16"
  }
}
